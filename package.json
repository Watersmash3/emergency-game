{
  "name": "emergency-game",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node ./apps/web/node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "build": "node ./apps/web/node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/simulation && tsc -p packages/content && tsc -p apps/web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
